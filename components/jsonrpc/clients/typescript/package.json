{
  "name": "@sen/client",
  "version": "0.0.0",
  "description": "TypeScript client for the Sen JSON-RPC over WebSocket gateway.",
  "license": "Apache-2.0",
  "author": "Airbus",
  "repository": {
    "type": "git",
    "url": "https://github.com/airbus/sen.git",
    "directory": "components/jsonrpc/clients/typescript"
  },
  "homepage": "https://airbus.github.io/sen/latest/",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^2.1.0"
  }
}
