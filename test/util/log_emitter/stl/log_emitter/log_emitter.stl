package log_emitter;

// How often log messages are emitted
enum EmitRate: u8
{
  slow,      // every ~5 seconds
  moderate,  // every ~1 second
  fast       // every ~0.2 seconds
}

// What kind of output to produce. Each names one route to the terminal, because the routes are
// captured by different mechanisms and a mode that mixes them cannot say which one failed.
enum OutputKind: u8
{
  spdlogOnly,  // a logger made through the kernel
  stderrOnly,  // std::cerr, which OutputCapture redirects
  mixed,       // spdlogOnly and stderrOnly alternating
  coutOnly,    // std::cout, buffered, sharing fd 1 with the renderer
  printfOnly,  // std::printf, reaching fd 1 through the C stdout FILE*
  plainSpdlog  // a logger from spdlog's own factory, which the kernel never saw made
}

// Configuration for the log emitter
struct EmitterConfig
{
  rate   : EmitRate,    // emission rate
  output : OutputKind,  // what kind of output to produce
  prefix : string       // prefix for emitted messages
}

// A test utility that periodically emits on one of the routes a program has to the terminal.
// One mode per route, so a test can tell a route term captures from one it paints over.
class Emitter
{
  // configuration
  var config : EmitterConfig [static];

  // a counter that increments each time a message is emitted
  var counter : u64;

  // the last message that was emitted
  var lastMessage : string [confirmed];

  // event fired each time a message is emitted
  event messageEmitted(message: string, level: string);
}
