[settings]
os=Linux
arch={{ detect_api.detect_arch() }}
compiler=clang
compiler.cppstd=17
compiler.version=20
build_type=Release

[options]
# Crashpad's Linux packaging always links libcurl, whose default pulls OpenSSL in behind it.
# Sen never uploads a report, so neither is needed. Options of a transitive dependency cannot
# be set from a recipe.
libcurl/*:with_ssl=False

[tool_requires]
!ninja/*: ninja/[~1]

[buildenv]
CC=clang-20
CXX=clang++-20

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmake_layout:build_folder_vars=['settings.compiler']
