// Generated by add_sen_package: the one translation unit per target carrying provenance.
// Keep these out of line. Inline in the header they read macros set on the whole target, which
// put the values on 233 of 617 compile command lines and made those objects uncacheable.
#include <sen/kernel/component.h>

#include <string>

namespace sen::kernel
{

const char* getGitRef() noexcept
{
  return "@_git_ref_spec@";
}

const char* getGitHash() noexcept
{
  return "@_git_hash@";
}

GitStatus getGitStatus() noexcept
{
  const std::string status {"@_git_status@"};
  if (status == "clean")
  {
    return GitStatus::clean;
  }
  if (status == "dirty")
  {
    return GitStatus::modified;
  }
  return GitStatus::unknown;
}

// The commit's timestamp. A wall-clock time cannot be accurate: an unchanged object is not
// recompiled, so it keeps whatever time it was first built at.
const char* getBuildTime() noexcept
{
  return "@_git_commit_date@";
}

}  // namespace sen::kernel
