@PACKAGE_INIT@
set(_sen_package_prefix "${PACKAGE_PREFIX_DIR}")

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
list(APPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(spdlog)

include("${CMAKE_CURRENT_LIST_DIR}/sen_targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/util/sen_utils.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/util/git_info.cmake")

# @PACKAGE_INIT@ computes this from the install destination, so it survives the config moving.
# The trailing slash is the published contract: consumers join onto it without a separator.
set(SEN_INSTALL_DIR "${_sen_package_prefix}/")

# These targets ship STL interfaces under the common installation root. Resolve
# the path when the package is loaded so it remains valid after relocation.
foreach(_sen_interface_target IN ITEMS sen::db sen::recorder sen::replayer)
  if(TARGET ${_sen_interface_target})
    set_property(TARGET ${_sen_interface_target} PROPERTY SEN_EXPORTS_TYPES YES)
    set_property(TARGET ${_sen_interface_target} PROPERTY SEN_IMPORT_DIRS -i "${SEN_INSTALL_DIR}interfaces")
  endif()
endforeach()
unset(_sen_interface_target)
unset(_sen_package_prefix)
