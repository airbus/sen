# Sen's config moved to <prefix>/@CMAKE_INSTALL_CMAKEDIR@. This stands at the old location so projects
# told to put <prefix>/cmake on CMAKE_PREFIX_PATH keep configuring, and is removable once that
# guidance has aged out.
get_filename_component(_sen_compat_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${_sen_compat_prefix}/@CMAKE_INSTALL_CMAKEDIR@/sen-config.cmake")
