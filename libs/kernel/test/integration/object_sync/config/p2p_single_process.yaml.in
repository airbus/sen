kernel:
  crashReportDisabled: true

load:
  - name: ether
    group: 10
    runDiscoveryHub: 65454
    discovery:
      type: TcpDiscovery
      value:
        beamPeriod: 100 ms
        beamExpiryTime: 1 s
        hubAddress:
          host: sen-hub
          port: 65454
build:
  - name: terminatorComp
    group: 2
    freqHz: 10
    imports: [test_helpers]
    objects:
      - name: terminator
        class: sen.test.ProcessTerminatorImpl
        bus: session.bus
  - name: nodeComp1
    group: 3
    freqHz: 60
    imports: [test_helpers, object_sync]
    objects:
      - name: node1
        class: object_sync.@NODE_TYPE@
        numOfNodes: 3
        bus: session.bus
  - name: nodeComp2
    group: 3
    freqHz: 60
    imports: [test_helpers, object_sync]
    objects:
      - name: node2
        class: object_sync.@NODE_TYPE@
        numOfNodes: 3
        bus: session.bus
  - name: nodeComp3
    group: 3
    freqHz: 60
    imports: [test_helpers, object_sync]
    objects:
      - name: node3
        class: object_sync.@NODE_TYPE@
        numOfNodes: 3
        bus: session.bus
