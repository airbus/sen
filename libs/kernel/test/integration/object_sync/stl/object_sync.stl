import "test_helpers/test_helpers.stl"

package object_sync;

class ListenerObjectSync : extends sen.test.Listener
{
  var query : string [static, confirmed];
}

struct TestStruct
{
  field1 : u32,
  field2 : string,
  field3 : f32
}

optional<f32> OptF32;

enum TestEnum : u8
{
  first,
  second,
  third
}

// Type used to evaluate correctness of writable properties through the network. Id is incremented and it is used to generate the value (which is then checked when reading )
struct WritablePropType
{
  id    : u32,
  value : u64
}

class TestObject
{
  var staticProp                                  : u8               [static];
  var staticNoConfigProp                          : TestEnum         [static_no_config];
  var bestEffortProp                              : f64              [bestEffort];
  var confirmedProp                               : TestStruct       [confirmed];
  var multicastProp                               : OptF32;
  var writableProp                                : WritablePropType [writable];

  event bestEffortEvent(id: u32, arg: TestStruct)                    [bestEffort];
  event confirmedEvent(id: u32, arg: string)                         [confirmed];
  event multicastEvent(id: u32, arg: OptF32);

  fn constMethod(arg: TestEnum)                   -> u32             [const];
  fn confirmedMethod(arg: u64)                    -> u8              [confirmed];
  fn bestEffortMethod(arg: string)                -> u64             [bestEffort];
  fn localMethod()                                -> u16             [local];
}
