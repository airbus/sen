<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- A second module in a different package adding one attribute to the same class. It carries no
     semantics, so it is a contribution rather than a second definition. -->
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2010">
    <modelIdentification>
        <name>Union B</name>
        <type>FOM</type>
        <version>1.0</version>
        <reference>
            <type>Dependency</type>
            <identification>Union A</identification>
        </reference>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <objectClass>
                <name>Vehicle</name>
                <attribute>
                    <name>Weight</name>
                    <dataType>Metres</dataType>
                    <updateType>Conditional</updateType>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <semantics>How heavy it is.</semantics>
                </attribute>
            </objectClass>
        </objectClass>
    </objects>
</objectModel>
