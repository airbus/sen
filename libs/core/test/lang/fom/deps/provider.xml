<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Declares the interaction the other module's class is mapped onto, so the mapping is only found
     by following a dependency. -->
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2010">
    <modelIdentification>
        <name>Provider Module</name>
        <type>FOM</type>
        <version>1.0</version>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
        </objectClass>
    </objects>
    <interactions>
        <interactionClass>
            <name>HLAinteractionRoot</name>
            <interactionClass>
                <name>Handover</name>
                <sharing>PublishSubscribe</sharing>
                <transportation>HLAreliable</transportation>
                <semantics>Control passes to someone else.</semantics>
                <parameter>
                    <name>Recipient</name>
                    <dataType>StationTag</dataType>
                    <semantics>Who takes over.</semantics>
                </parameter>
            </interactionClass>
        </interactionClass>
    </interactions>
    <dataTypes>
        <simpleDataTypes>
            <simpleData>
                <name>StationTag</name>
                <representation>HLAinteger32BE</representation>
                <units>NA</units>
                <semantics>Names a station.</semantics>
            </simpleData>
        </simpleDataTypes>
    </dataTypes>
</objectModel>
