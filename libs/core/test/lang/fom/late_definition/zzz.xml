<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Read last, and the complete definition. Its semantics are what the class gets, which is how a
     test can tell that the owner is chosen by semantics and not by read order. -->
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2010">
    <modelIdentification>
        <name>Late Z</name>
        <type>FOM</type>
        <version>1.0</version>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <objectClass>
                <name>Vehicle</name>
                <sharing>PublishSubscribe</sharing>
                <semantics>The defining declaration, read last.</semantics>
                <attribute>
                    <name>Speed</name>
                    <dataType>Knots</dataType>
                    <updateType>Conditional</updateType>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <semantics>How fast it goes.</semantics>
                </attribute>
            </objectClass>
        </objectClass>
    </objects>
    <dataTypes>
        <simpleDataTypes>
            <simpleData>
                <name>Knots</name>
                <representation>HLAinteger32BE</representation>
                <units>NA</units>
                <semantics>A speed.</semantics>
            </simpleData>
        </simpleDataTypes>
    </dataTypes>
</objectModel>
