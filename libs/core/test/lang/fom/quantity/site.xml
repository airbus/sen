<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- A simple data type with a unit Sen's unit map knows, which makes it a quantity rather than an
     alias. -->
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2010">
    <modelIdentification>
        <name>Quantity Module</name>
        <type>FOM</type>
        <version>1.0</version>
    </modelIdentification>
    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <objectClass>
                <name>Vehicle</name>
                <sharing>PublishSubscribe</sharing>
                <semantics>A vehicle.</semantics>
                <attribute>
                    <name>Speed</name>
                    <dataType>SpeedMetresPerSecond</dataType>
                    <updateType>Conditional</updateType>
                    <sharing>PublishSubscribe</sharing>
                    <transportation>HLAreliable</transportation>
                    <semantics>How fast it goes.</semantics>
                </attribute>
            </objectClass>
        </objectClass>
    </objects>
    <dataTypes>
        <simpleDataTypes>
            <simpleData>
                <name>SpeedMetresPerSecond</name>
                <representation>HLAfloat32BE</representation>
                <units>meter per second (m/s)</units>
                <semantics>A speed.</semantics>
            </simpleData>
        </simpleDataTypes>
    </dataTypes>
</objectModel>
